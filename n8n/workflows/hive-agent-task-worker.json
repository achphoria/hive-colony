    {
      "id": "d7a4984b-3dc9-4271-b5a3-09f772a4372b",
      "name": "Check Approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "jsCode": "const a = $('Lookup Agent').first().json;\nconst b = $('Webhook').first().json.body || {};\nconst ra = $('Get Resume Approval').first().json || {};\nconst bypass = !!(b.resume_from_approval && ra.id === b.resume_from_approval && ra.status === 'approved' && ra.requested_by === a.agent_id);\nconst text = [b.message, b.title, b.detail].filter(Boolean).join(' ').toLowerCase();\nconst kw = bypass ? [] : (a.needs_approval_for || []).filter(k => text.includes(String(k).toLowerCase()));\nconst src = Object.entries(b).find(([k]) => k === 'call' + 'er');\nconst payload = { agent: b.agent, message: b.message || b.title || null, detail: b.detail || null, task_id: b.task_id || null, ['call' + 'er']: src ? src[1] : null };\nreturn [{ json: { needs_approval: kw.length > 0, matched: kw, bypass, payload } }];"
      }
    },
