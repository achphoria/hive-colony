    {
      "id": "bd8d871d-23e1-4a39-be25-4c07f04db9c7",
      "name": "Call Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueErrorOutput",
      "position": [
        1100,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: $('Lookup Agent').item.json.model, max_tokens: 1024, system: $('Lookup Agent').item.json.system_prompt, messages: [{ role: 'user', content: ($('Webhook').item.json.body.message || $('Webhook').item.json.body.title || '') + ($('Webhook').item.json.body.detail ? '\\n\\nDetail: ' + $('Webhook').item.json.body.detail : '') }] }) }}",
        "options": {}
      },
      "credentials": {
        "anthropicApi": {
          "id": "kFy6xuuDb1bW23WT",
          "name": "Anthropic - Hive Agents"
        }
      }
    },
    {
      "id": "d7151def-b62c-46c7-a95d-cad78ec0e088",
      "name": "Parse Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst reply = (r.content || []).filter(c => c.type === 'text').map(c => c.text).join('\\n').trim();\nconst a = $('Lookup Agent').first().json;\nconst b = $('Webhook').first().json.body || {};\nreturn [{ json: { reply, agent: a.agent_id, nick: a.nick, dept: a.dept, task_id: b.task_id || null } }];"
      }
    },
