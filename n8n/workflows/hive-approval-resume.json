      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, skipped: true, status: $('Get Approval').first().json.status }) }}",
        "options": {}
      },
      "id": "2700b3dc-607b-4d69-accc-76dab4dc0c68"
    },
    {
      "name": "Has Payload?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "Has Payload?",
              "leftValue": "={{ $json.payload }}",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              }
            }
          ]
        },
        "looseTypeValidation": true
      },
      "id": "2a520659-3913-4001-a59e-d59549888b60"
