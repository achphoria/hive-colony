      "typeVersion": 1.1,
      "position": [
        1100,
        400
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'missing_payload', hint: 'Tambah kolom payload jsonb di hc_approvals dan simpan request asli saat Create Approval' }) }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "6f77d3d0-4cd0-4279-8f17-7b2c51a160f1"
    },
    {
      "name": "Call Task Worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [
        1100,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://sliceable-mousiness-exorcist.ngrok-free.dev/webhook/hive/agent-task",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "ngrok-skip-browser-warning",
              "value": "1"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({}, typeof $('Get Approval').first().json.payload === 'string' ? JSON.parse($('Get Approval').first().json.payload) : ($('Get Approval').first().json.payload || {}), { resume_from_approval: $('Get Approval').first().json.id })) }}",
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "tcVY2EJbqHcERiSJ",
          "name": "Hive Webhook Secret"
        }
      },
      "id": "0aafee30-99ff-4e01-941b-3500dcd3b098"
    },
    {
      "name": "Log Resume",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "tableId": "hc_activity",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "kind",
              "fieldValue": "approval_resumed"
            },
            {
              "fieldId": "dept",
              "fieldValue": "={{ $('Get Approval').item.json.dept }}"
            },
            {
              "fieldId": "text",
              "fieldValue": "={{ 'Approval disetujui, dijalankan ulang [' + $('Get Approval').first().json.id + ']: ' + ($('Get Approval').first().json.title || '') }}"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "ZbVvCjvCLHBNrgXQ",
          "name": "Supabase - General Table"
        }
      },
      "id": "7da03e4c-8e9c-4bc9-a423-00b349e4549c"
    },
